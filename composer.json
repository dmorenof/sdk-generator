{
    "name": "dmorenof/sdk-generator",
    "description": "Contract-driven PHP SDK generator, built around a small reusable runtime.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/yaml": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Dmorenof\\SdkGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmorenof\\SdkGenerator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "validate": "@composer validate --strict --no-check-lock"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk-runtime",
            "options": {"symlink": false}
        }
    ],
    "keywords": [
        "sdk",
        "generator",
        "php",
        "api-client",
        "openapi"
    ],
    "homepage": "https://github.com/dmorenof/sdk-generator",
    "authors": [
        {
            "name": "David Moreno Falero",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dmorenof/sdk-generator/issues",
        "source": "https://github.com/dmorenof/sdk-generator"
    },
    "require-dev": {
        "dmorenof/sdk-runtime": "@dev",
        "phpunit/phpunit": "^11.5",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0"
    },
    "bin": [
        "bin/generate-sdk.php"
    ]
}
