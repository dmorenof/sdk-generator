{
  "openapi": "3.1.0",
  "info": {
    "title": "Parameter Overrides API",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://example.test"
    }
  ],
  "paths": {
    "/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 2
          }
        },
        {
          "name": "body",
          "in": "query",
          "schema": {
            "type": "string",
            "minLength": 9
          }
        },
        {
          "name": "selector",
          "in": "query",
          "style": "form",
          "explode": false,
          "schema": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 4
            }
          }
        },
        {
          "name": "selector",
          "in": "header",
          "schema": {
            "type": "string",
            "maxLength": 1
          }
        },
        {
          "name": "theme",
          "in": "cookie",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "style": "label",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "selector",
            "in": "query",
            "schema": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "name": "selector",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          }
        ],
        "responses": {
          "204": {
            "description": "OK"
          }
        }
      },
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "style": "matrix",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "selector",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Form"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "parameters": [],
        "responses": {
          "204": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Form": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
