{
  "openapi": "3.1.0",
  "info": {
    "title": "Example Accounts",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.example.test/v1"
    }
  ],
  "paths": {
    "/users/{id}": {
      "$ref": "#/components/pathItems/ReadAlias",
      "summary": "Read user route"
    },
    "/users": {
      "$ref": "#/components/pathItems/CreateUser"
    }
  },
  "components": {
    "schemas": {
      "NewUser": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "admin"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "visits": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "admin"
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "parameters": {
      "ID/~": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "Identifier": {
        "$ref": "#/components/parameters/ID~1~0"
      },
      "Détail": {
        "name": "verbose",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      }
    },
    "requestBodies": {
      "NewUser": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NewUser"
            }
          }
        }
      },
      "CreateAlias": {
        "$ref": "#/components/requestBodies/NewUser"
      }
    },
    "responses": {
      "User/~": {
        "description": "ok",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "Created": {
        "description": "created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "ReadAlias": {
        "$ref": "#/components/responses/User~1~0"
      }
    },
    "pathItems": {
      "ReadUser": {
        "get": {
          "operationId": "getUser",
          "parameters": [
            {
              "$ref": "#/components/parameters/D%C3%A9tail"
            }
          ],
          "responses": {
            "200": {
              "$ref": "#/components/responses/ReadAlias"
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Identifier"
          }
        ]
      },
      "CreateUser": {
        "post": {
          "operationId": "createUser",
          "requestBody": {
            "$ref": "#/components/requestBodies/CreateAlias"
          },
          "responses": {
            "201": {
              "$ref": "#/components/responses/Created"
            }
          }
        }
      },
      "ReadAlias": {
        "$ref": "#/components/pathItems/ReadUser"
      }
    }
  }
}
