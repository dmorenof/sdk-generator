{
  "openapi": "3.1.0",
  "info": {
    "title": "Deep Query",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example.test/v1"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "getItems",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          {
            "name": "body",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          {
            "name": "options",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "name": "X-Trace",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          }
        }
      },
      "post": {
        "operationId": "postItems",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          {
            "name": "body",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          {
            "name": "options",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "name": "X-Trace",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Payload"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Filter": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city-name"
        ],
        "properties": {
          "city-name": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "internal": {
            "type": "string",
            "readOnly": true
          },
          "secret": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "Payload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filter"
        ],
        "properties": {
          "filter": {
            "type": "string"
          }
        }
      }
    }
  }
}
