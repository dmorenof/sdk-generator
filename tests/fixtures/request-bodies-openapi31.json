{
  "openapi": "3.1.0",
  "info": {
    "title": "Request Bodies API",
    "version": "1"
  },
  "paths": {
    "/scalar": {
      "post": {
        "operationId": "postScalar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextAlias"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/optional": {
      "post": {
        "operationId": "postOptional",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Choice"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/null": {
      "post": {
        "operationId": "postNull",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "null"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/list/{id}": {
      "post": {
        "operationId": "postList",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersAlias"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "body",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Test",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/loose": {
      "post": {
        "operationId": "postLoose",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LooseList"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/map": {
      "post": {
        "operationId": "postMap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scores"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/open": {
      "post": {
        "operationId": "postOpen",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Anything"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    },
    "/never": {
      "post": {
        "operationId": "postNever",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Impossible"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Text": {
        "type": "string",
        "minLength": 2
      },
      "TextAlias": {
        "$ref": "#/components/schemas/Text"
      },
      "Choice": {
        "type": [
          "string",
          "integer",
          "null"
        ],
        "minLength": 2,
        "minimum": 0
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/TextAlias"
          },
          "readOnlyId": {
            "type": "integer",
            "readOnly": true
          }
        }
      },
      "Users": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/User"
        }
      },
      "UsersAlias": {
        "$ref": "#/components/schemas/Users"
      },
      "LooseList": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "Scores": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "Anything": true,
      "Impossible": false
    }
  }
}