{
  "openapi": "3.1.0",
  "info": {
    "title": "Delimited Queries",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.example.test/v1"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "style": "spaceDelimited"
          },
          {
            "name": "codes",
            "in": "query",
            "style": "pipeDelimited",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "flags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            },
            "style": "spaceDelimited"
          },
          {
            "name": "weights",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "style": "pipeDelimited"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          }
        }
      }
    }
  }
}
