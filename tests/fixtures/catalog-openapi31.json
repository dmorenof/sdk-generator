{
  "openapi": "3.1.0",
  "info": {
    "title": "Sample Library Catalog",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://catalog.example.test/api/v2"
    }
  ],
  "components": {
    "schemas": {
      "BookDraft": {
        "type": "object",
        "required": [
          "title",
          "price"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "genre": {
            "type": "string",
            "enum": [
              "fiction",
              "nonfiction"
            ]
          }
        }
      },
      "Warehouse": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "sku",
          "title",
          "price"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "genre": {
            "type": "string",
            "enum": [
              "fiction",
              "nonfiction"
            ]
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          },
          "available": {
            "type": "boolean"
          },
          "warehouse": {
            "$ref": "#/components/schemas/Warehouse"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/books/{sku}": {
      "get": {
        "operationId": "findBook",
        "parameters": [
          {
            "in": "path",
            "name": "sku",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "expand",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    },
    "/books": {
      "post": {
        "operationId": "addBook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        }
      }
    }
  }
}
