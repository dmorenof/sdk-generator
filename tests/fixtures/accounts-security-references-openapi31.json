{
  "openapi": "3.1.0",
  "info": {
    "title": "Example Accounts",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.example.test/v1"
    }
  ],
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewUser": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "admin"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "visits": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "admin"
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerBase": {
        "type": "http",
        "scheme": "bearer"
      },
      "HeaderKeyBase": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "QueryKeyBase": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key"
      },
      "BasicBase": {
        "type": "http",
        "scheme": "basic"
      },
      "Bearer": {
        "$ref": "#/components/securitySchemes/BearerHop"
      },
      "HeaderKey": {
        "$ref": "#/components/securitySchemes/HeaderKeyBase"
      },
      "QueryKey": {
        "$ref": "#/components/securitySchemes/QueryKeyBase"
      },
      "Basic": {
        "$ref": "#/components/securitySchemes/BasicBase"
      },
      "BearerHop": {
        "$ref": "#/components/securitySchemes/BearerBase"
      }
    }
  },
  "security": [
    {
      "Bearer": [],
      "HeaderKey": []
    },
    {
      "QueryKey": []
    },
    {
      "Basic": []
    }
  ]
}
