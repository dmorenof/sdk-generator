          "active"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "server-id": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "Form": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
